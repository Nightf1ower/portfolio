{
  "name": "yaroslav-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:stickers": "node scripts/generate-stickers-manifest.mjs",
    "generate:galleries": "node scripts/generate-portfolio-galleries-manifest.mjs",
    "generate:assets": "npm run generate:stickers && npm run generate:galleries",
    "dev": "npm run generate:assets && vite --host 0.0.0.0",
    "build": "npm run generate:assets && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "postcss": "latest",
    "autoprefixer": "latest"
  }
}
